{
  "name": "asepad",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "postinstall": "pnpm -r --filter @asentrise/blockchain... build",
    "dev": "pnpm --filter @asentrise/web dev",
    "dev:web": "pnpm --filter @asentrise/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @asentrise/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "contracts:deploy": "pnpm --filter @asentrise/contracts run deploy",
    "contracts:sync-env": "node scripts/sync-contract-env.mjs",
    "contracts:reset": "node scripts/reset-contract-env.mjs",
    "contracts:fees": "pnpm --filter @asentrise/contracts fees:check",
    "deployer:info": "pnpm --filter @asentrise/contracts deployer:info",
    "format": "prettier . --check"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "@asentum/sdk": "^0.1.0"
  }
}
